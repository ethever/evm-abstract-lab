{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nix: build",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--no-update-lock-file",
        "${workspaceFolder}",
        "--command",
        "cargo",
        "build",
        "--locked",
        "--workspace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Nix: check affected",
      "type": "process",
      "command": "nix",
      "args": [
        "run",
        "--no-update-lock-file",
        "${workspaceFolder}#check-changes",
        "--"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Nix: test workspace (Cargo)",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--no-update-lock-file",
        "${workspaceFolder}",
        "--command",
        "cargo",
        "test",
        "--locked",
        "--workspace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Nix: clippy",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--no-update-lock-file",
        "${workspaceFolder}",
        "--command",
        "cargo",
        "clippy",
        "--locked",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Nix: full merge gate",
      "type": "process",
      "command": "nix",
      "args": [
        "flake",
        "check",
        "--print-build-logs",
        "--no-update-lock-file"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}

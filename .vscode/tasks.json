{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nix: build",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--no-update-lock-file",
        "${workspaceFolder}",
        "--command",
        "cargo",
        "build",
        "--locked",
        "--workspace"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Nix: test",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--no-update-lock-file",
        "${workspaceFolder}",
        "--command",
        "cargo",
        "test",
        "--locked",
        "--workspace"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Nix: clippy",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--no-update-lock-file",
        "${workspaceFolder}",
        "--command",
        "cargo",
        "clippy",
        "--locked",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    }
  ]
}

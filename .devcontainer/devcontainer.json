{
  "name": "evm-abstract-lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/nix:1.4.0": {
      "multiUser": true,
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}"
  },
  "postCreateCommand": ["./scripts/rust-analyzer-nix.sh", "--version"],
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
